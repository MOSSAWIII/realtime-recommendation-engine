erDiagram
    UTILISATEUR {
        int user_id PK
        varchar(10) locale
        float birthyear
        varchar(10) gender
        datetime joinedAt
        varchar(100) location
        int timezone
    }
    
    EVENEMENT {
        int event_id PK
        int user_id FK
        datetime start_time
        varchar(50) city
        varchar(50) state
        varchar(20) zip
        varchar(50) country
        decimal lat
        decimal lng
        int c_1
        int c_2_to_99
        int c_100
        int c_other
    }
    
    RESEAU_AMIS {
        int user_id PK,FK
        text friends_list
    }
    
    PARTICIPATION_EVENEMENT {
        int event_id PK,FK
        text yes_list
        text maybe_list
        text invited_list
        text no_list
    }
    
    UTILISATEUR ||--o{ EVENEMENT : "crée"
    UTILISATEUR ||--|| RESEAU_AMIS : "possède"
    EVENEMENT ||--|| PARTICIPATION_EVENEMENT : "a"
    UTILISATEUR }o--o{ EVENEMENT : "participe via PARTICIPATION_EVENEMENT"
