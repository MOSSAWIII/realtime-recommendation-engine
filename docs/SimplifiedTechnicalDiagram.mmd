flowchart TD
    Client[Application Client]
    
    subgraph RMQ[RabbitMQ Message Broker]
        UAExch["user_actions_exchange (topic)"]
        HDQueue[historical_data_queue]
        PEQueue[processed_events_queue]
        RecQueue[recommendations_queue]
    end
    
    Transform[Transformer]
    Recomm[Recommender]
    DM[DataManager]
    DB[(PostgreSQL)]
    
    %% Relations
    Client -->|Comportement et interactions| UAExch
    Client -->|Données| HDQueue
    
    UAExch --> Transform
    Transform --> PEQueue
    PEQueue --> Recomm
    Recomm --> RecQueue
    RecQueue --> Client
    
    HDQueue --> DM
    DM <--> DB
    DM -->|Données Historique| Recomm
    DB --> Transform
    
    classDef broker fill:#e1f5fe,stroke:#01579b
    classDef queue fill:#b3e5fc,stroke:#0288d1
    classDef component fill:#fff9c4,stroke:#f57f17
    classDef database fill:#e8f5e9,stroke:#2e7d32
    
    class RMQ broker
    class UAExch,HDQueue,PEQueue,RecQueue queue
    class Transform,Recomm,DM,Client component
    class DB database