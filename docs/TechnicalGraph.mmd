graph TB
    %% Sources de données
    UserApp([Application Client]) -->|"Génère"| UE([UserEvent])
    UE ==>|"JSON"| Q_USER["RabbitMQ: USER_EVENTS<br>durable=true"]
    
    %% Pipeline principal (avec référence aux classes)
    Q_USER -->|"Consomme messages<br>basicAck=manual"| SC[StreamingConsumer]
    SC ==>|"UserEvent"| TR[Transformer]
    TR ==>|"ProcessedEvent<br>storeProcessedEvent()"| REP[Repository]
    TR -.->|"Si itemId présent<br>publishRecommendationRequest()"| RR([RecommendationRequest]) 
    RR -.->|"JSON via RabbitMQ"| Q_INT["INTERNAL_RECOMMENDATION_REQUESTS"]
    Q_INT -->|"Consomme"| REC[Recommender]
    
    %% Accès aux données
    REP <-->|"JDBC + PreparedStatement<br>HikariCP connection pool"| PG[(PostgreSQL)]
    
    %% Architecture Repository avec relations hiérarchiques claires
    subgraph "Architecture Repository"
      BASEREPO[BaseRepository<br>méthodes communes]
      REPOINTERFACE[RepositoryInterface<br>définit contrat]
      REPO[Repository<br>implémentation principale]
      CONCRETEREPO[ConcreteRepository<br>extends Repository]
      
      REPOINTERFACE -.->|"définit interface"| REPO
      BASEREPO -.->|"extends"| REPO
      REPO -->|"extends"| CONCRETEREPO
    end
    
    %% Repositories spécifiques avec leurs relations
    REPO -->|"provides methods for"| UREPO[UserRepository]
    REPO -->|"provides methods for"| EREPO[EventRepository]
    REPO -->|"provides methods for"| PREPO[ParticipationRepository] 
    REPO -->|"provides methods for"| FREPO[FriendsRepository]
    
    %% Mécanismes de résilience - simplifié et plus clair
    subgraph "Mécanismes de résilience"
      RETRY[Retry avec backoff<br>maxRetries=3]
      ACK["Acknowledge manuel<br>basicAck avec deliveryTag"]
      ERROR[Try/Catch + Logging<br>LoggerFactory.getLogger]
      RETRY_LOGIC[RabbitMQManager.connect<br>avec backoff exponentiel]
      
      BASEREPO -->|"implémente"| RETRY
      BASEREPO -->|"implémente"| ERROR
      SC -->|"utilise"| ACK
      REC -->|"utilise"| ACK
      RETRY_LOGIC -->|"gère reconnexions"| RETRY
    end
    
    %% Données de référence avec types de données spécifiés
    Q_REF_U["RabbitMQ: USER_INTERACTIONS"] -.->|"User JSON"| CM[ConsumerManager]
    Q_REF_E["RabbitMQ: EVENT_UPDATES"] -.->|"Event JSON"| CM
    Q_REF_P["RabbitMQ: PARTICIPATION_UPDATES"] -.->|"Participation JSON"| CM
    Q_REF_F["RabbitMQ: FRIENDSHIP_UPDATES"] -.->|"Friendship JSON"| CM
    
    %% Flux de données vers repositories spécifiques
    CM -->|"upsert(user)"| UREPO
    CM -->|"upsert(event)"| EREPO
    CM -->|"upsert(participation)"| PREPO
    CM -->|"upsert(friendship)"| FREPO
    
    %% Flux de données détaillé du Recommender vers repositories
    REC -->|"getProcessedEventsForUser(userId, limit)"| REP
    REC -->|"getUserProfile(userId)"| UREPO
    REC -->|"getUserFriends(userId)"| FREPO
    REC -->|"getAllActiveEvents()"| EREPO
    REC -->|"storeRecommendation(recommendation)"| REP
    REC ==>|"Recommendation JSON"| Q_REC["RabbitMQ: RECOMMENDATIONS"]
    
    %% Algorithme de recommandation avec pondérations exactes du code
    subgraph "Algorithme de recommandation"
      BEHAVIOR[Comportement actuel<br>CurrentBehaviorWeight=0.6]
      CONTEXT[Contexte social & géo<br>ContextualWeight=0.3]
      HISTORY[Historique<br>HistoricalWeight=0.1]
      
      BEHAVIOR ==>|"Fréquence d'interaction<br>recencyScore+frequencyScore"| SCORE[Score final]
      CONTEXT ==>|"Proximité & amis<br>isSameLocation() + participatingFriends"| SCORE
      HISTORY ==>|"categoryMatchCount*15.0"| SCORE
    end
    
    %% Structure des données avec champs exacts depuis le code
    subgraph "Modèles de données"
        PE["ProcessedEvent<br>id: Option[Long], userId: Long,<br>eventType: String, itemId: Option[Long],<br>properties: Map[String, String],<br>timestamp: Long, processingTimestamp: Long"]
        RI["RecommendedItem<br>itemId: Long, score: Double, reason: String"]
        RC["Recommendation<br>id: Option[Long], userId: Long,<br>recommendedItems: List[RecommendedItem],<br>score: Double, timestamp: Long"]
    end
    
    %% Relations des données
    PE -.->|"Transforme en"| RC
    RC o-->|"contains"| RI
    TR -->|"Crée"| PE
    REC -->|"Génère"| RC
    
    %% Cycle de vie des données amélioré
    subgraph "Cycle de vie des données"
      direction LR
      CAPTURE[Capture<br>UserEvent] ==>|"StreamingConsumer"| TRANSFORM[Transformation<br>ProcessedEvent]
      TRANSFORM ==>|"Repository"| STORE[Stockage<br>PostgreSQL]
      STORE ==>|"Recommender"| USE[Utilisation<br>algorithme]
      USE ==>|"RabbitMQ"| PUBLISH[Publication<br>affichage]
    end
    
    %% Légende améliorée
    subgraph "Légende"
      COMPONENT[Composant logiciel]
      QUEUE[(Queue RabbitMQ)]
      DATABASE[(Base de données)]
      EVENT([Événement/Message])
      ASYNC-.->|"Appel asynchrone"| SYNC
      SYNC-->|"Appel synchrone"| DB
      DATA_FLOW==>|"Flux de données principal"| ENDPOINT
    end
    
    %% Styles - conservés et étendus
    classDef component fill:#f9a825,stroke:#f57f17,stroke-width:1px,color:#000
    classDef queue fill:#81d4fa,stroke:#0288d1,stroke-width:1px,color:#000
    classDef data fill:#c5e1a5,stroke:#558b2f,stroke-width:1px,color:#000
    classDef store fill:#ce93d8,stroke:#7b1fa2,stroke-width:1px,color:#000
    classDef model fill:#fff59d,stroke:#fbc02d,stroke-width:1px,color:#000

    %% Appliquer les styles
    class SC,TR,REC,CM component
    class Q_USER,Q_INT,Q_REC,Q_REF_U,Q_REF_E,Q_REF_P,Q_REF_F queue
    class PE,RI,RC,UE,RR data
    class PG store
    
    %% Styles de flux
    style SYNC_CALL stroke:#333,stroke-width:2px
    style ASYNC_CALL stroke:#666,stroke-width:1px,stroke-dasharray: 5 5
    style DATA_FLOW stroke:#558b2f,stroke-width:2.5px