FROM sbtscala/scala-sbt:eclipse-temurin-jammy-17.0.8.1_1_1.9.6_2.13.12

WORKDIR /app

# Copier d'abord les fichiers de configuration
COPY project/ project/
COPY build.sbt .

# Pré-télécharger les dépendances
RUN sbt update

# Copier le code source et les tests
COPY src/ src/

# Configuration test-specific
COPY src/test/resources/application-test.conf /app/src/main/resources/application.conf

# Compiler le projet mais ne pas lancer les tests
RUN sbt compile